image_uri          = "123456789012.dkr.ecr.eu-north-1.amazonaws.com/gpu-compare@sha256:REPLACE_WITH_DIGEST"
session_secret_arn = "arn:aws:secretsmanager:eu-north-1:123456789012:secret:gpu-compare/session-REPLACE"
# Reuse an account's existing provider if present.
existing_github_oidc_arn = ""

database_secret_arn = "arn:aws:secretsmanager:eu-north-1:123456789012:secret:gpu-compare/db-REPLACE"
# First deployment uses the local portfolio profile. No GitHub OIDC calls by default.
enable_github_deploy = false
